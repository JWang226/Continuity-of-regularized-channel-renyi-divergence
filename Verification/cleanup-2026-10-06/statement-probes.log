def QuantumChannelContinuity.regularizedRenyi : {H K : Type} →
  [inst : Qudit H] → [inst_1 : Qudit K] → [Nontrivial H] → [Nontrivial K] → ℝ → CPTP H K → CPTP H K → ℝ≥0∞ :=
fun {H K} [Qudit H] [Qudit K] [Nontrivial H] [Nontrivial K] α N M =>
  ⨆ n, ⨆ (_ : 0 < n), QuantumChannelContinuity.blockRenyi α N M n / ↑n
def QuantumChannelContinuity.regularizedRelative : {H K : Type} →
  [inst : Qudit H] → [inst_1 : Qudit K] → [Nontrivial H] → [Nontrivial K] → CPTP H K → CPTP H K → ℝ≥0∞ :=
fun {H K} [Qudit H] [Qudit K] [Nontrivial H] [Nontrivial K] N M =>
  ⨆ n, ⨆ (_ : 0 < n), QuantumChannelContinuity.blockRelative N M n / ↑n
